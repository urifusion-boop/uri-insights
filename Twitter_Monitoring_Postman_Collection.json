		{
			"name": "Lead Forms (for testing)",
			"item": [
				{
					"name": "Create Test Lead Form",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"user_id\": \"{{user_id}}\",\n    \"type\": \"conversational\",\n    \"keywords\": [\n        \"looking for CRM\",\n        \"need sales software\",\n        \"CRM recommendations\",\n        \"sales automation\"\n    ],\n    \"buying_signals\": [\n        \"budget approved\",\n        \"ready to buy\",\n        \"need help\",\n        \"looking for solution\",\n        \"recommend\"\n    ],\n    \"excluded_keywords\": [\n        \"free only\",\n        \"competitor_name\"\n    ],\n    \"ai_response_guide\": \"Be friendly and helpful. Mention our CRM features. Ask qualifying questions about their business size and needs.\",\n    \"business_summary\": \"We provide AI-powered CRM solutions for small to medium-sized businesses. Our platform includes lead tracking, email automation, and analytics.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/lead-forms/conversation-search/create",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"lead-forms",
								"conversation-search",
								"create"
							]
						},
						"description": "Create a test lead form for Twitter monitoring. Save the returned lead_form_id for starting monitoring."
					},
					"response": []
				},
				{
					"name": "Get Lead Form by ID",
					"request": {
						"method": "GET",
						"header": [
